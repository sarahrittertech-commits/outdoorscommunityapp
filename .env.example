# Copy to .env.local for local development. Never commit real values.
#
# Local values come from `npx supabase start` (it prints them), or
# `npx supabase status`. Production values come from the Supabase dashboard
# and are set as Railway environment variables.

# Public: safe in the browser. Row-level security limits what the anon key can do.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# The site's own address, used in sign-in links, sitemaps and link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# There is deliberately no SUPABASE_SERVICE_ROLE_KEY here. The web app never
# uses it (TR-SEC-3). Server-side jobs read it from Supabase's own secrets.
